# Namuna. Haqiqiy `.env` repoga tushmaydi (`.gitignore` da).
# Serverda nusxa oling va qiymatlarni to'ldiring:
#     cp .env.example .env

# Sessiya tokenlarini imzolaydi. Har muhitda O'ZINIKI bo'lsin va hech kimga
# ko'rsatilmasin — buni bilgan odam istalgan foydalanuvchi nomidan kira oladi.
# Yasash:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google bilan kirish. console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client IDs.
#
# "Authorized redirect URIs" ro'yxatiga quyidagi qo'shilgan bo'lsin:
#     https://uzbekpdf.uz/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Saytning tashqi manzili. Google shu manzilga qaytaradi, shuning uchun
# lokalda sinaganda uni http://localhost:8100 ga o'zgartiring.
BASE_URL=https://uzbekpdf.uz
